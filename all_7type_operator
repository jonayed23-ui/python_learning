#Assignment Operators — put the value on the Variable 
x = 10
x += 5    # x = x + 5
print(x)  # output: 15
x -= 3    # x = x - 3
print(x)  # output: 12
x *= 2    # x = x * 2
print(x)  # output: 24
x /= 4    # x = x / 4
print(x)  # output: 6.0
x //= 2   # x = x // 2
print(x)  # output: 3.0
x %= 2    # x = x % 2
print(x)  # output: 1.0
x **= 3   # x = x ** 3
print(x)  # output: 1.0

#Comparison Operators — Compare values and return a Boolean result
a = 10
b = 20
print(a == b)  # Equal to
print(a != b)  # Not equal to
print(a > b)   # Greater than
print(a < b)   # Less than
print(a < b)     
print(a >= 10)   
print(a <= 9) 
# String comparison — alphabetically
print("apple" == "apple")    # output: True
print("apple" < "banana")    # 'a' < 'b' alphabetically -> output: True
print("Zebra" < "apple")

# Chained comparison
age = 25
print(18 < age < 30)  

marks = 75
grade = "A" if marks >= 90 else "B" if marks >= 80 else "C" if marks >= 70 else "D" if marks >= 60 else "F"
print(grade)  

